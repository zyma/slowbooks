# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: external managed Postgres. Most providers need SSL, keep ?sslmode=require.
# Fallback for offline work: docker compose --profile localdb up -d
#   postgres://slowbooks:slowbooks@localhost:5433/slowbooks
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Email for magic links. Leave RESEND_API_KEY empty in dev: links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Slow Books <hello@slowbooks.local>"

# S3-compatible storage (docker-compose runs MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=slowbooks
S3_ACCESS_KEY_ID=slowbooks
S3_SECRET_ACCESS_KEY=slowbooks123
S3_FORCE_PATH_STYLE=true

# Gemini (Google AI Studio key, free tier is enough to start). Transcribes the recording when the
# browser cannot recognize speech, and gently cleans up the text. Without a key the raw text is used.
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=

# Production only (deploy/docker-compose.yml): public hostname for Caddy and HTTPS
# DOMAIN=slowbooks.example.com
